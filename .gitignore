# Dependencies
node_modules/

# Build output
dist/
.output/
extension-dist/

# Release 附件（二进制，走 GitHub Releases 分发）
# 但上架文案（*.md）与商店图标素材要进仓库，否则换机即丢
release/*.zip
# 合成前的原始截图不入库（尺寸不合规、且可能含个人书签/会话名）；
# 合成后的商店成品要留，换机重装时不用再截一遍
release/screenshots/raw/
release/TabPocket-v*/

# WXT generated
.wxt/

# Temp debug files
test-vite.mjs
rolldown-test*

# Logs
*.log
npm-debug.log*

# Python 脚本缓存（scripts/*.py 用）
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
