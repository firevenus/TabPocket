{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "0.6.1",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "contextMenus",
    "unlimitedStorage",
    "bookmarks",
    "history",
    "idle"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  }
}
